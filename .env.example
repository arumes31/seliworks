# Copy to .env. Run scripts/init-secrets.sh before Compose.
APP_URL=https://work.example.com
APP_ENV=production
PROXY_NETWORK=proxy
PROXY_ALIAS=seliworks
# Use the actual reverse proxy IP/subnet, never 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=172.30.0.2/32
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_NAME=Administrator
BACKUP_DIR=./backups
# Organization timezone defaults to Europe/Vienna in Settings. Container logs use UTC.
# Optional invoice SMTP delivery. Leave SMTP_HOST empty to disable.
# Put the SMTP credential in .secrets/smtp_password, never in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_IMPLICIT_TLS=false
LOG_LEVEL=info
